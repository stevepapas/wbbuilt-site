---
import { assetUrl } from '../utils/paths';

interface Props {
  src: string;
  poster?: string;
  title: string;
  caption?: string;
}

const { src, poster, title, caption } = Astro.props;
---
<section class="portfolio-reel">
  <div class="portfolio-reel-inner">
    <div class="portfolio-reel-copy">
      <h2>Project reel</h2>
      {caption && <p>{caption}</p>}
    </div>
    <div class="portfolio-reel-player">
      <video
        controls
        playsinline
        preload="metadata"
        poster={poster ? assetUrl(poster) : undefined}
        aria-label={title}
      >
        <source src={assetUrl(src)} type="video/mp4" />
      </video>
    </div>
  </div>
</section>

<style>
  .portfolio-reel {
    background: #ccbfac;
    width: 100%;
    padding: clamp(40px, 6vw, 64px) 0;
    margin-bottom: clamp(40px, 6vw, 64px);
  }
  .portfolio-reel-inner {
    width: min(var(--max), calc(100% - 48px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    align-items: start;
    gap: clamp(32px, 5vw, 72px);
  }
  .portfolio-reel-copy {
    min-width: 0;
  }
  .portfolio-reel-copy h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 12px;
    max-width: none;
  }
  .portfolio-reel-copy p {
    margin: 0;
    color: #4a4740;
    max-width: 38ch;
    line-height: 1.65;
  }
  .portfolio-reel-player {
    width: 100%;
    max-width: 300px;
    justify-self: end;
    background: #111;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.14);
  }
  .portfolio-reel-player video {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    vertical-align: middle;
  }
  @media (max-width: 760px) {
    .portfolio-reel-inner {
      grid-template-columns: 1fr;
    }
    .portfolio-reel-player {
      justify-self: start;
      max-width: 280px;
    }
  }
</style>
